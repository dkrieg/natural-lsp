{
  "id": "natural-lsp",
  "name": "Natural LSP",
  "programArgs": {
    "default": "natural-lsp --stdio",
    "windows": "natural-lsp.exe --stdio"
  },
  "fileTypeMappings": [
    {
      "fileType": {
        "name": "Natural",
        "patterns": [
          "*.NSP",
          "*.NSN",
          "*.NSS",
          "*.NSC",
          "*.NSM",
          "*.NSL",
          "*.NSG",
          "*.NSA",
          "*.NSH",
          "*.NSD",
          "*.NS4",
          "*.NS7",
          "*.NS3",
          "*.NS8",
          "*.NST"
        ]
      },
      "languageId": "natural"
    }
  ]
}
